// SDL_image 3 — image files decoded, for sysl.
//
//     dependencies {
//       sdl3-image { git = "github.com/sysl-lang/sdl3-image", version = "0.2.1" }
//     }
//
// **SDL3 and SDL3_image both have to be installed** — `brew install sdl3_image` pulls both — and a
// build needs the prefix on the command line:
//
//     sysl run prog.sysl --include-path sdl3=/opt/homebrew/include --link-path /opt/homebrew/lib
//
// The include path is named `sdl3=` because it answers *that* package's header requirement: this
// one transcribes no constants and so asks the C compiler for nothing, but `sh.sysl.sdl3.c` does.
//
// This is a separate package from `sdl3` rather than a module inside it, and the reason is
// mechanical: a link directive is never pruned, so a program that only drew rectangles would still
// be handed `-lSDL3_image` and would not link on a machine without it.

package {
  name    = "sdl3-image"
  version = "0.2.1"
}

// The core binding, for `Surface`, `Renderer` and `Texture` — and for their C handles, which
// `sh.sysl.sdl3_image.c` names in its own declarations. It is fetched by the
// coordinate below, so nothing has to be checked out beside this repository.
dependencies {
  sdl3 { git = "github.com/sysl-lang/sdl3", version = "0.2.1" }
}

requires {
  heap  = true
  posix = true

  // `sh.sysl.sdl3_image.c` asks the C compiler for SDL_image's constants rather than transcribing them,
  // so the headers are read at compile time and not only at link time — and `@link("SDL_image")` needs
  // the library itself at the end of it. SDL_image ships a `sdl3-image.pc` that answers both, so the machine
  // is asked and the consumer types nothing.
  //
  // **This package declared no requirement at all until 0.2.1**, which meant a consumer without
  // SDL_image installed met clang reporting a header they had never heard of, and this file said
  // nothing. So this is a new declaration rather than a swap of the `headers` key its siblings had.
  //
  // The name is pkg-config's: the module is `sh.sysl.sdl3_image`, the link directive says `SDL_image`,
  // and pkg-config files it as `sdl3-image`. Three spellings, none derivable from the others.
  //
  // `sdl3` itself is not named here — it is a dependency and its own manifest declares it.
  pkg_config {
    sdl3-image = "SDL_image — `brew install sdl3_image` on macOS, Debian's libsdl3-image-dev, and pkg-config finds it either way"
  }
}
